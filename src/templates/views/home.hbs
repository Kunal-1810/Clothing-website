<title>The Clothing Loop - Online Clothing for Men, Women & Kids</title>
<meta name="description" content="Shop clothing for men, women, and kids online at The Clothing Loop. Explore trendy fashion, stylish outfits, everyday wear, and the latest collections at affordable prices. Enjoy great offers, discover styles for every occasion, and find your favourite clothing with a convenient online shopping experience.">
<meta name="keywords" content="shop clothes online, clothing collection, shirts, jeans, dresses, kidswear, menswear, womenswear, buy fashion online, online clothing store, fashion store, trendy clothes, affordable fashion, stylish clothing, online shopping for clothes, clothing website, online boutique, fashion deals, clothing sale, fashion discounts">

<link rel="canonical" href="https://clothing-website-delta-three.vercel.app/">
<meta property="og:title" content="The Clothing Loop - Online Clothing for Men, Women & Kids">
<meta property="og:description" content="Shop clothing for men, women and kids online at The Clothing Loop. Easy ordering, great styles, great offers and good prices.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://clothing-website-delta-three.vercel.app/">
<link rel="stylesheet" href="/css/home.css">

{{> navbar}}

<div class="home-content">
  <div class="home-text">
    <h3>New season arrivals: men's, women's and kid's fashion</h3>
    <p>Up to 30% off on selected styles</p>
  </div>
  <div class="home-button">
    <a href="/products" class="shop-btn">Shop now</a>
  </div>
</div>

<div class="categories">
  <a class="category" href="/men">👦 Men</a>
  <a class="category" href="/women">👩 Women</a>
  <a class="category" href="/kids">👶 Kids</a>
</div>

<form class="search" action="/products" method="GET">
  <input class="search-input" type="text" name="q" placeholder="Search for products...">
  <button class="search-btn" type="submit">Search</button>
</form>

<div class="products">

  <div class="hoodie">
    {{#each hoodies}}
    <div class="product-card">
      <img src="/{{this.image}}" alt="{{this.name}}">
      <div class="product-info">
        <h4><a class="card-link" href="/products/{{this._id}}">{{this.name}}</a></h4>
        <p class="price">₹{{money this.price}}</p>
        <div class="sizes">
          {{#each this.sizes}}<span class="size">{{this}}</span>{{/each}}
        </div>
        <a href="/products/{{this._id}}" class="view-btn">View</a>
      </div>
    </div>
    {{/each}}
  </div>

  <br><br>

  <div class="Bottomwear">
    {{#each bottomwear}}
    <div class="product-card">
      <img src="/{{this.image}}" alt="{{this.name}}">
      <div class="product-info">
        <h4><a class="card-link" href="/products/{{this._id}}">{{this.name}}</a></h4>
        <p class="price">₹{{money this.price}}</p>
        <div class="sizes">
          {{#each this.sizes}}<span class="size">{{this}}</span>{{/each}}
        </div>
        <a href="/products/{{this._id}}" class="view-btn">View</a>
      </div>
    </div>
    {{/each}}
  </div>

</div>

<footer>
  <p>&copy; 2026 The Clothing Loop. All rights reserved.</p>
</footer>
