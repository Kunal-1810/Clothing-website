<link rel="stylesheet" href="/css/home.css">

{{> navbar}}

<div class="home-content">
  <div class="home-text">
    <h3>New season arrivals : men's, women's and kid's fashion</h3>
    <p>Up to 30% off on selected styles</p>
  </div>
  <div class="home-button">
    <a href="/products" class="shop-btn">Shop now</a>
  </div>
</div>

<div class="categories">
  <a class="category" href="/men">👦 Men</a>
  <a class="category" href="/women">👩 Women</a>
  <a class="category" href="/kids">👶 Kids</a>
</div>

<form class="search" action="/products" method="GET">
  <input class="search-input" type="text" name="q" placeholder="Search for products...">
  <button class="search-btn" type="submit">Search</button>
</form>

